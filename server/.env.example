# Local development configuration.
# Copy to .env (`make env`). Never commit .env — production secrets come from Key Vault.

# --- Runtime -----------------------------------------------------------------
LEDGERFLOW_ENV=local
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=true

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=ledgerflow
POSTGRES_PASSWORD=ledgerflow_local_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Per-context connection strings. Each service may only use its own
# (docs/architecture/bounded-contexts.md).
IDENTITY_DATABASE_URL=postgres://identity_app:identity_local_password@localhost:5432/ledgerflow_identity
MERCHANT_DATABASE_URL=postgres://merchant_app:merchant_local_password@localhost:5432/ledgerflow_merchant
PAYMENT_DATABASE_URL=postgres://payment_app:payment_local_password@localhost:5432/ledgerflow_payment
LEDGER_DATABASE_URL=postgres://ledger_app:ledger_local_password@localhost:5432/ledgerflow_ledger
SETTLEMENT_DATABASE_URL=postgres://settlement_app:settlement_local_password@localhost:5432/ledgerflow_settlement
RECONCILIATION_DATABASE_URL=postgres://reconciliation_app:reconciliation_local_password@localhost:5432/ledgerflow_reconciliation
RISK_DATABASE_URL=postgres://risk_app:risk_local_password@localhost:5432/ledgerflow_risk
NOTIFICATION_DATABASE_URL=postgres://notification_app:notification_local_password@localhost:5432/ledgerflow_notification

# --- Redis -------------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Kafka -------------------------------------------------------------------
KAFKA_PORT=29092
KAFKA_BROKERS=localhost:29092
KAFKA_UI_PORT=8080

# --- Observability -----------------------------------------------------------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3100
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
JAEGER_UI_PORT=16686
LOKI_PORT=3101

# --- Acquirer simulator ------------------------------------------------------
ACQUIRER_MODE=SUCCESS
ACQUIRER_BASE_URL=http://localhost:3009
