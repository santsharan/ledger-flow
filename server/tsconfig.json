{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@ledgerflow/*": ["packages/*/src"]
    }
  },
  "include": [
    "apps/*/src/**/*.ts",
    "packages/*/src/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "vitest.aliases.ts",
    "vitest.integration.setup.ts"
  ],
  "exclude": ["**/dist/**", "node_modules"]
}
