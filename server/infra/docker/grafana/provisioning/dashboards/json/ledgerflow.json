{
  "title": "LedgerFlow",
  "uid": "ledgerflow",
  "timezone": "utc",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "row",
      "title": "Payments",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "type": "stat",
      "title": "Payments created",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [{ "expr": "sum(payments_created_total)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Payments captured",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [{ "expr": "sum(payments_captured_total)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Payments failed",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [{ "expr": "sum(payments_failed_total)", "refId": "A" }]
    },
    {
      "type": "row",
      "title": "Ledger",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "type": "stat",
      "title": "Journals posted",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 6 },
      "targets": [{ "expr": "sum(ledger_journals_posted_total)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Journal failures",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 6 },
      "targets": [{ "expr": "sum(ledger_journal_failures_total)", "refId": "A" }]
    },
    {
      "type": "row",
      "title": "Settlement and reconciliation",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 }
    },
    {
      "type": "stat",
      "title": "Settlements completed",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 11 },
      "targets": [{ "expr": "sum(settlements_completed_total)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Reconciliation mismatches",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 11 },
      "targets": [{ "expr": "sum(reconciliation_mismatches_total)", "refId": "A" }]
    },
    {
      "type": "row",
      "title": "API and database",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "type": "timeseries",
      "title": "HTTP p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le, service) (rate(http_server_duration_milliseconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Database query p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(db_client_operation_duration_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "title": "Messaging",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 24 }
    },
    {
      "type": "stat",
      "title": "Dead letters",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 25 },
      "targets": [{ "expr": "sum(dead_letter_total)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Outbox backlog",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 25 },
      "targets": [{ "expr": "sum(outbox_backlog)", "refId": "A" }]
    }
  ]
}
